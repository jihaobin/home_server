        "@repo/types": "workspace:*",
        "@repo/utils": "workspace:*",
        "@scalar/nestjs-api-reference": "^0.5.12",
        "@sesamecare-oss/redlock": "^1.4.0",
        "@types/nodemailer": "^6.4.17",
        "@types/pg": "^8.15.4",
        "alipay-sdk": "^4.14.0",
        "aliyun-api-gateway": "^1.1.6",
