{
    "extends": "@repo/mobile-ui/tsconfig.json",
    "compilerOptions": {
        "strict": true,
        "jsxImportSource": "nativewind",
        "paths": {
            "@/*": [
                "./*"
            ],
            "@repo/mobile-ui/*": [
                "../../packages/mobile-ui/src/*"
            ]
        }
    },
    "include": [
        "**/*.ts",
        "**/*.tsx",
        ".expo/types/**/*.ts",
        "expo-env.d.ts",
        "nativewind-env.d.ts",
        "postcss.config.mjs"
, "app.config.js"    ]
}