{
    "expo": {
        "name": "叮咚上门",
        "slug": "mobile-user",
        "version": "1.1.6",
        "newArchEnabled": true,
        "orientation": "portrait",
        "icon": "./assets/images/icon.png",
        "scheme": "home-server-user",
        "userInterfaceStyle": "automatic",
        "ios": {
            "supportsTablet": true,
            "bundleIdentifier": "com.yixin.dingdong"
        },
        "android": {
            "softwareKeyboardLayoutMode": "resize",
            "permissions": [
                "android.permission.ACCESS_COARSE_LOCATION",
                "android.permission.ACCESS_FINE_LOCATION",
                "android.permission.REQUEST_INSTALL_PACKAGES",
                "android.permission.READ_PHONE_STATE",
                "android.permission.WRITE_EMBEDDED_SUBSCRIPTIONS"
            ],
            "blockedPermissions": [
                "android.permission.WRITE_EXTERNAL_STORAGE"
            ],
            "package": "com.yixin.dingdong",
            "intentFilters": [
                {
                    "action": "VIEW",
                    "data": [
                        {
                            "scheme": "home-server-user",
                            "host": "check-in"
                        },
                        {
                            "scheme": "https",
                            "host": "worker.example.com",
                            "pathPrefix": "/check-in"
                        }
                    ],
                    "category": [
                        "BROWSABLE",
                        "DEFAULT"
                    ]
                }
            ],
            "jsEngine": "hermes"
        },
        "web": {
            "bundler": "metro",
            "output": "static",
            "favicon": "./assets/images/favicon.png"
        },
        "plugins": [
            "./plugins/withAndroidSignature",
            [
                "./plugins/withTimpushConfig",
                {
                    "source": "./plugins/timpush-configs.json"
                }
            ],
            "expo-router",
            [
                "expo-splash-screen",
                {
                    "image": "./assets/images/icon.png",
                    "imageWidth": 200,
                    "resizeMode": "contain",
                    "backgroundColor": "#ffffff"
                }
            ],
            [
                "expo-secure-store",
                {
                    "configureAndroidBackup": true,
                    "faceIDPermission": "Allow $(PRODUCT_NAME) to access your Face ID biometric data."
                }
            ],
            [
                "expo-location",
                {
                    "locationAlwaysAndWhenInUsePermission": "当前应用需要访问您的位置，已获取你的服务地址"
                }
            ],
            [
                "expo-qq-location",
                {
                    "apiKey": "WLEBZ-HCTC3-JMN3L-OLTJV-R2AJE-WCB7J"
                }
            ],
            "expo-font",
            "expo-web-browser",
            [
                "native-expo-alipay",
                {
                    "appId": "9021000153675106"
                }
            ],
            [
                "../../packages/mobile-ui/plugins/withJVerification",
                {
                    "appKey": "310ada9739aaf74b6744256b",
                    "channel": "default"
                }
            ],
            [
                "expo-build-properties",
                {
                    "android": {
                        "buildArchs": [
                            "arm64-v8a"
                        ],
                        "reactNativeReleaseLevel": "experimental"
                    }
                }
            ],
            [
                "expo-video",
                {
                    "supportsBackgroundPlayback": true,
                    "supportsPictureInPicture": true
                }
            ],
            [
                "expo-camera",
                {
                    "cameraPermission": "为了拍摄照片和视频，请允许$(PRODUCT_NAME)访问你的相机",
                    "microphonePermission": "为了录制视频声音，请允许$(PRODUCT_NAME)访问你的麦克风"
                }
            ]
        ],
        "experiments": {
            "typedRoutes": true
        },
        "extra": {
            "router": {},
            "jverification": {
                "appKey": "310ada9739aaf74b6744256b",
                "channel": "default",
                "isProduction": false
            },
            "eas": {
                "projectId": "56004597-0fe8-4294-9aad-4566216d42bf"
            }
        }
    }
}