{
    "name": "marketing-web",
    "version": "0.1.0",
    "private": true,
    "scripts": {
        "dev": "node scripts/generate-blog.mjs && node scripts/generate-legal.mjs && dotenvx run -f .env.development -- next dev --turbopack",
        "build": "node scripts/generate-blog.mjs && node scripts/generate-legal.mjs && dotenvx run -f .env.production -- next build",
        "start": "dotenvx run -f .env.production -- next start",
        "lint": "eslint . --max-warnings 0",
        "type-check": "tsc -p tsconfig.json --noEmit"
    },
    "dependencies": {
        "clsx": "^2.1.1",
        "gray-matter": "^4.0.3",
        "next": "^16.1.0",
        "react": "catalog:react19-2",
        "react-dom": "catalog:react19-2",
        "react-markdown": "^10.1.0",
        "remark-gfm": "^4.0.1",
        "rehype-autolink-headings": "^7.1.0",
        "rehype-slug": "^6.0.0",
        "tailwind-merge": "^3.3.1"
    },
    "devDependencies": {
        "@eslint/eslintrc": "^3",
        "@repo/eslint-config": "workspace:*",
        "@repo/typescript-config": "workspace:*",
        "@tailwindcss/postcss": "^4",
        "@types/node": "^20",
        "@types/react": "catalog:react19-2",
        "@types/react-dom": "catalog:react19-2",
        "eslint": "^9",
        "eslint-config-next": "^16.0.0",
        "tailwindcss": "^4",
        "typescript": "^5"
    }
}
