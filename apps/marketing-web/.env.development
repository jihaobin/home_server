
# ===== 来自 env/development/.env.marketing =====
# ===========================================
# 开发环境 - Marketing 站点配置 (仅限marketing-web可访问)
# ===========================================

# Next dev 端口，避免与 admin-web(3000) 冲突
PORT=3010

# 站点信息（可选：代码内已固定 canonical 为 https://dingsm.com）
NEXT_PUBLIC_SITE_URL=http://localhost:3010
NEXT_PUBLIC_CANONICAL_URL=https://dingsm.com
NEXT_PUBLIC_DOWNLOAD_URL=https://dingsm.com/file/apk/mobile-user


# ===== 来自 env/development/.env.common =====
# ===========================================
# 开发环境 - 公共配置 (所有项目可访问)
# ===========================================

NODE_ENV=development

# 域名配置
DOMAIN_NAME=192.168.0.110:5050
NEXT_PUBLIC_WEB_HOST=http://localhost:3000

# API配置
NEXT_PUBLIC_API_URL=http://192.168.0.110:5050/api
NEXT_PUBLIC_AUTH_BASE_URL=http://192.168.0.110:5050


