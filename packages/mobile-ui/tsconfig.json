{
    "extends": "@repo/typescript-config/react-native.json",
  "compilerOptions": {
    "jsx": "react-jsx",
    "strict": true,
    "paths": {
      "@/*": [
        "./*"
      ],
      "@repo/mobile-ui/*": ["../../packages/mobile-ui/src/*"]
    }
  },
  "include": [
    "**/*.ts",
    "**/*.tsx",
    ".expo/types/**/*.ts",
    "expo-env.d.ts",
    "nativewind-env.d.ts",
    "tailwind.config.js"
  ],
    "exclude": ["node_modules", "dist"]
}
