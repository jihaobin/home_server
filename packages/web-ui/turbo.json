{
  "extends": ["//"],
  "tasks": {
    "build": {
      "outputs": ["dist/**", "types/**"],
      "inputs": [
        "$TURBO_DEFAULT$",
        "!**/*.stories.*",
        "!**/*.test.*",
        "!**/*.spec.*"
      ]
    },
    "dev": {
